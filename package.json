{
  "name": "marketplace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:api": "pnpm --filter @marketplace/api start:dev",
    "dev:worker": "pnpm --filter @marketplace/api start:dev:worker",
    "dev:web": "pnpm --filter @marketplace/web dev",
    "dev": "pnpm run \"/^dev:(api|web)$/\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @marketplace/api test:e2e",
    "admin:create": "pnpm --filter @marketplace/api admin:create",
    "demo:seed": "pnpm --filter @marketplace/api demo:seed",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "db:generate": "pnpm --filter @marketplace/db generate",
    "db:migrate": "pnpm --filter @marketplace/db migrate:dev",
    "db:seed": "pnpm --filter @marketplace/api db:seed",
    "db:studio": "pnpm --filter @marketplace/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose --profile app down",
    "app:up": "docker compose --profile app up -d --build",
    "app:down": "docker compose --profile app down"
  }
}
