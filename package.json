{
  "name": "ecommerce",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:api": "pnpm --filter @ecommerce/api start:dev",
    "dev:worker": "pnpm --filter @ecommerce/worker start:dev",
    "dev:web": "pnpm --filter @ecommerce/web dev",
    "dev": "pnpm run \"/^dev:(api|web)$/\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ecommerce/api test:e2e",
    "demo:flow": "pnpm --filter @ecommerce/api demo:flow",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @ecommerce/db generate",
    "db:migrate": "pnpm --filter @ecommerce/db migrate:dev",
    "db:seed": "pnpm --filter @ecommerce/api db:seed",
    "db:studio": "pnpm --filter @ecommerce/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
