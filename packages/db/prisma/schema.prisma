generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin

  @@map("role")
}

enum UserStatus {
  active
  banned

  @@map("user_status")
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  username          String     @unique
  usernameChangedAt DateTime?  @map("username_changed_at") @db.Timestamptz(3)
  role              Role       @default(user)
  status            UserStatus @default(active)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions          Session[]
  shop              Shop?
  cartItems         CartItem[]
  addresses         Address[]
  orders            Order[]
  checkouts         Checkout[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  previousTokenHash String?   @unique @map("previous_token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ShopStatus {
  pending
  active
  rejected
  banned

  @@map("shop_status")
}

model Shop {
  id            String       @id @default(uuid(7)) @db.Uuid
  ownerId       String       @unique @map("owner_id") @db.Uuid
  name          String       @unique
  nameChangedAt DateTime?    @map("name_changed_at") @db.Timestamptz(3)
  description   String?
  status        ShopStatus   @default(pending)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner         User         @relation(fields: [ownerId], references: [id])
  items         Item[]
  address       ShopAddress?
  orders        Order[]

  @@index([status])
  @@map("shops")
}

enum ItemStatus {
  active
  hidden
  banned

  @@map("item_status")
}

model Item {
  id             String          @id @default(uuid(7)) @db.Uuid
  shopId         String          @map("shop_id") @db.Uuid
  // Seller's own product code; groups rows in a CSV import and blocks duplicate imports.
  parentSku      String?         @map("parent_sku")
  name           String
  description    String?
  // Packed weight in grams, used for shipping fees.
  weight         Int
  status         ItemStatus      @default(active)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop           Shop            @relation(fields: [shopId], references: [id])
  tierVariations TierVariation[]
  models         Model[]

  @@unique([shopId, parentSku])
  @@index([shopId, status])
  @@map("items")
}

model TierVariation {
  id       String       @id @default(uuid(7)) @db.Uuid
  itemId   String       @map("item_id") @db.Uuid
  position Int
  name     String
  item     Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options  TierOption[]

  @@unique([itemId, position])
  @@map("tier_variations")
}

model TierOption {
  id              String        @id @default(uuid(7)) @db.Uuid
  tierVariationId String        @map("tier_variation_id") @db.Uuid
  position        Int
  option          String
  tierVariation   TierVariation @relation(fields: [tierVariationId], references: [id], onDelete: Cascade)

  @@unique([tierVariationId, position])
  @@map("tier_options")
}

model Model {
  id         String              @id @default(uuid(7)) @db.Uuid
  itemId     String              @map("item_id") @db.Uuid
  tierIndex  Int[]               @map("tier_index")
  sku        String?
  price      Int
  // Set when variations are replaced; kept because order items reference it.
  // tier_index is unique per item among live models (partial index models_live_tier_index).
  deletedAt  DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  item       Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  movements  InventoryMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([itemId])
  @@map("models")
}

// Sellable quantity = onHand - reserved. reserved holds stock for orders awaiting payment.
model Inventory {
  modelId   String   @id @map("model_id") @db.Uuid
  onHand    Int      @map("on_hand")
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

enum InventoryReason {
  restock
  adjust
  reserve
  release
  sale
  return

  @@map("inventory_reason")
}

// Append-only history of every change to Inventory.onHand or reserved.
// delta is the change to on_hand for restock/adjust/sale/return and to reserved for reserve/release;
// a sale also releases the same quantity from reserved.
model InventoryMovement {
  id             String          @id @default(uuid(7)) @db.Uuid
  modelId        String          @map("model_id") @db.Uuid
  delta          Int
  reason         InventoryReason
  refType        String?         @map("ref_type")
  refId          String?         @map("ref_id")
  idempotencyKey String?         @unique @map("idempotency_key")
  actorId        String?         @map("actor_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  model          Model           @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId, createdAt])
  @@map("inventory_movements")
}

// One line per user and model; stock is not reserved until checkout.
model CartItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  modelId    String   @map("model_id") @db.Uuid
  quantity   Int
  // Model price when last added, so the cart can show how the price moved since.
  addedPrice Int      @map("added_price")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model      Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([modelId])
  @@map("cart_items")
}

enum WardType {
  ward
  commune
  special_zone

  @@map("ward_type")
}

model Province {
  code     String @id
  name     String
  fullName String @map("full_name")
  wards    Ward[]

  @@map("provinces")
}

model Ward {
  code          String        @id
  name          String
  fullName      String        @map("full_name")
  provinceCode  String        @map("province_code")
  type          WardType
  province      Province      @relation(fields: [provinceCode], references: [code])
  addresses     Address[]
  shopAddresses ShopAddress[]

  @@index([provinceCode])
  @@map("wards")
}

model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name")
  phone         String
  wardCode      String   @map("ward_code")
  street        String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ward          Ward     @relation(fields: [wardCode], references: [code])

  @@index([userId])
  @@map("addresses")
}

model ShopAddress {
  shopId      String   @id @map("shop_id") @db.Uuid
  contactName String   @map("contact_name")
  phone       String
  wardCode    String   @map("ward_code")
  street      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ward        Ward     @relation(fields: [wardCode], references: [code])

  @@map("shop_addresses")
}

enum OrderStatus {
  to_ship
  shipping
  completed
  cancelled

  @@map("order_status")
}

// One buyer action that may create several orders (one per shop); replays return the same orders.
model Checkout {
  id             String   @id @default(uuid(7)) @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  buyer          User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@unique([buyerId, idempotencyKey])
  @@map("checkouts")
}

// Addresses, names and prices are snapshots, so later edits never change a placed order.
model Order {
  id              String               @id @default(uuid(7)) @db.Uuid
  checkoutId      String               @map("checkout_id") @db.Uuid
  buyerId         String               @map("buyer_id") @db.Uuid
  shopId          String               @map("shop_id") @db.Uuid
  status          OrderStatus          @default(to_ship)
  itemsTotal      Int                  @map("items_total")
  shippingFee     Int                  @map("shipping_fee")
  total           Int
  shippingAddress Json                 @map("shipping_address")
  pickupAddress   Json                 @map("pickup_address")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  checkout        Checkout             @relation(fields: [checkoutId], references: [id])
  buyer           User                 @relation(fields: [buyerId], references: [id])
  shop            Shop                 @relation(fields: [shopId], references: [id])
  items           OrderItem[]
  history         OrderStatusHistory[]

  @@index([buyerId, status])
  @@index([shopId, status])
  @@index([checkoutId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  modelId   String  @map("model_id") @db.Uuid
  itemName  String  @map("item_name")
  modelName String? @map("model_name")
  sku       String?
  price     Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  model     Model   @relation(fields: [modelId], references: [id])

  @@index([orderId])
  @@index([modelId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}
